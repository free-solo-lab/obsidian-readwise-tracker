{
	"name": "readwise-reading-tracker",
	"version": "1.2.0",
	"description": "Track reading activity, manage Reader books and tags, import files and URLs, and turn highlights into linked notes.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -p tsconfig.build.json --noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "tsx --tsconfig tsconfig.test.json --test tests/**/*.test.ts",
		"lint": "eslint . --ext .ts,.tsx,.mjs",
		"check": "npm run lint && npm test && npm run build",
		"release": "node scripts/release.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"readwise",
		"reading",
		"highlights",
		"analytics"
	],
	"author": "Kostya Struga",
	"license": "MIT",
	"devDependencies": {
		"@types/chart.js": "^2.9.41",
		"@types/node": "^16.11.6",
		"@types/react": "^18.3.27",
		"@types/react-dom": "^18.3.7",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"esbuild": "0.17.3",
		"eslint": "^8.57.1",
		"obsidian": "^1.13.1",
		"tslib": "2.4.0",
		"tsx": "^4.19.2",
		"typescript": "4.7.4"
	},
	"dependencies": {
		"chart.js": "^4.4.0",
		"react": "^18.2.0",
		"react-chartjs-2": "^5.2.0",
		"react-dom": "^18.2.0"
	}
}
