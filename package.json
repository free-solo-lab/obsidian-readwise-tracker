{
	"name": "readwise-reading-tracker",
	"version": "1.0.0",
	"description": "Track Readwise reading progress, highlights, heatmaps, and reading inbox notes.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -p tsconfig.build.json --noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "tsx --tsconfig tsconfig.test.json --test tests/**/*.test.ts",
		"lint": "eslint . --ext .ts,.tsx,.mjs",
		"release": "node scripts/release.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": ["obsidian", "readwise", "reading", "highlights", "analytics"],
	"author": "Kostya Struga",
	"license": "MIT",
	"devDependencies": {
		"@types/chart.js": "^2.9.41",
		"@types/node": "^16.11.6",
		"@types/react": "^18.3.27",
		"@types/react-dom": "^18.3.7",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"eslint": "^8.57.1",
		"esbuild": "0.17.3",
		"obsidian": "^1.7.2",
		"tsx": "^4.19.2",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	},
	"dependencies": {
		"@types/uuid": "^10.0.0",
		"axios": "^1.6.0",
		"chart.js": "^4.4.0",
		"react": "^18.2.0",
		"react-chartjs-2": "^5.2.0",
		"react-dom": "^18.2.0",
		"uuid": "^13.0.0"
	}
}
